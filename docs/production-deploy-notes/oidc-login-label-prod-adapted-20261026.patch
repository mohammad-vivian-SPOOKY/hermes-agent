@@ -286,7 +286,7 @@ def _sql_session_last_active_by_id(session_id_expr: str) -> str:
 # (schema_read_probe_statements), never by this number, and its catch-up is the declarative
 # executescript(SCHEMA_SQL) + _reconcile_columns() every writable open already runs (additive,
 # idempotent). The bump only records that the declared shape changed; a new table or column needs no bump.
-SCHEMA_VERSION = 32
+SCHEMA_VERSION = 33
 
 # Auto-maintenance VACUUMs only above this freelist fraction; below it a rewrite costs more I/O than it returns.
 # Auto-maintenance only VACUUMs when at least this fraction of the database file is reclaimable (``PRAGMA
diff --git a/hermes_state_mutation_binding.py b/hermes_state_mutation_binding.py
index 07b964d3b7..bd2840f430 100644
--- a/hermes_state_mutation_binding.py
+++ b/hermes_state_mutation_binding.py
@@ -35,6 +35,58 @@ def _login_label(subject):
     return None if label.startswith('auth:') else label
 
 
+_LEGACY_LABEL_CUTOVER_KEY = 'legacy_login_label_cutover'
+
+
+def _legacy_transport_label(subject):
+    """What ``tui_gateway/session_transports.py::_transport_auth_user_id`` stamped on a row
+    BEFORE it carried the full subject: ``<provider>:<user>``, issuer dropped regardless of
+    whether one is present. Unlike ``_login_label`` (which deliberately still refuses an
+    issuer-bearing subject — that refusal protects every row stamped under the CURRENT,
+    full-subject scheme), this exists only to let a genuine owner's first post-upgrade touch
+    reclaim a row stamped under the OLD scheme, where the issuer was never captured at all and
+    provider+user was genuinely the only identity information stored. Never used on its own as
+    a permanent equivalence — see ``_legacy_label_eligible`` for the bound that keeps it from
+    reopening once a provider is backed by more than one issuer."""
+    from gateway.session_identity import parse_authenticated_subject
+    parts = parse_authenticated_subject(subject)
+    if parts is None:
+        return None
+    provider, _issuer, user = parts
+    if ':' in provider or not provider.strip() or not user.strip():
+        return None
+    label = f'{provider.strip()}:{user.strip()}'
+    return None if label.startswith('auth:') else label
+
+
+def _legacy_label_cutover(conn):
+    """Unix timestamp this install's ``state.db`` crossed the schema version that switched row
+    stamping from the lossy ``<provider>:<user>`` form to the full subject (written once, by the
+    schema migration, the first time that version is reached — see hermes_state_schema.py).
+    ``None`` on a store that hasn't crossed it yet (migration chain order means this can only
+    happen mid-migration-chain on first open, not in steady state) or one that somehow lacks the
+    marker — either way, the legacy fallback below must refuse rather than guess."""
+    row = conn.execute(
+        "SELECT value FROM state_meta WHERE key=?", (_LEGACY_LABEL_CUTOVER_KEY,)).fetchone()
+    try:
+        return float(row[0]) if row is not None else None
+    except (TypeError, ValueError):
+        return None
+
+
+def _legacy_label_eligible(conn, row):
+    """Whether *row* may still be matched via ``_legacy_transport_label`` instead of requiring an
+    exact full-subject match. Bounded to rows that demonstrably predate this host's cutover to
+    full-subject stamping — a row created after the cutover can only have been stamped by the
+    CURRENT code, which never writes the lossy form, so treating it as legacy-eligible would mean
+    guessing an equivalence that was never structurally guaranteed (the exact gap that let one
+    provider name collide across two different issuers). A row with no ``started_at`` (should not
+    happen for a real row, but never assumed) is treated as NOT eligible — fail closed, not open."""
+    cutover = _legacy_label_cutover(conn)
+    started_at = row['started_at'] if 'started_at' in row.keys() else None
+    return cutover is not None and isinstance(started_at, (int, float)) and started_at < cutover
+
+
 def import_history_control(conn, actor, session_ids):
     binding = json.dumps([actor.profile_id, actor.subject], separators=(',', ':'))
     for sid in session_ids:
@@ -59,11 +111,27 @@ def authorize_history(conn, actor, session_id, *, claim=False):
         return True
     if row['source'] not in _history_sources():
         return False
-    if _owner_user(row) and row['user_id'] not in (actor.subject, _login_label(actor.subject)):
-        raise RuntimeStoreError('permission_denied')
+    owner = _owner_user(row)
+    legacy_upgrade = False
+    if owner and owner not in (actor.subject, _login_label(actor.subject)):
+        # The exact/current-scheme match failed. A row stamped before this host's cutover to
+        # full-subject stamping may still carry the old, issuer-dropped `<provider>:<user>`
+        # form — the ONLY case that fallback may resolve, bounded by _legacy_label_eligible so
+        # it can never reopen once a provider is backed by more than one issuer (see that
+        # function's docstring). Anything else (a genuinely foreign owner, or a row created
+        # after the cutover that still mismatches) is refused exactly as before.
+        if _legacy_label_eligible(conn, row) and owner == _legacy_transport_label(actor.subject):
+            legacy_upgrade = True
+        else:
+            raise RuntimeStoreError('permission_denied')
     if 'session:create' not in actor.capabilities:
         raise RuntimeStoreError('permission_denied')
     if claim:
+        if legacy_upgrade:
+            # First touch by the genuine owner since this host crossed the full-subject cutover:
+            # upgrade the row in place so every later comparison hits the precise, issuer-bearing
+            # match directly and this fallback is never consulted for it again.
+            conn.execute('UPDATE sessions SET user_id=? WHERE id=?', (actor.subject, session_id))
         conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?)', (key, binding))
     return True
 
diff --git a/hermes_state_schema.py b/hermes_state_schema.py
index c83e6b2156..edb90ce4f4 100644
--- a/hermes_state_schema.py
+++ b/hermes_state_schema.py
@@ -1009,10 +1009,17 @@ class SessionSchemaMixin:
             # Store provenance so fresh vs wiped stores are distinguishable.
             # See #97568.
             now_iso = datetime.datetime.now(datetime.UTC).isoformat()
+            from hermes_state_mutation_binding import _LEGACY_LABEL_CUTOVER_KEY
             cursor.executemany(
                 "INSERT OR IGNORE INTO state_meta (key, value) VALUES (?, ?)",
                 [("store_instance_id", str(uuid.uuid4())), ("store_created_at_utc", now_iso),
-                 (_MESSAGE_UID_BACKFILL_DONE, "1")],  # a fresh store has no legacy rows to backfill
+                 (_MESSAGE_UID_BACKFILL_DONE, "1"),  # a fresh store has no legacy rows to backfill
+                 # A fresh store's row-stamping has always used the full subject (no legacy
+                 # `<provider>:<user>` form is ever written by current code), so nothing predates
+                 # this moment in the store's own life — EXCEPT an import of previously-exported
+                 # legacy session data into this brand-new store, which is exactly the case this
+                 # marker exists to keep working (see hermes_state_mutation_binding.py).
+                 (_LEGACY_LABEL_CUTOVER_KEY, str(time.time()))],
             )
         else:
             self._run_data_migrations(cursor, row[0], fts5_available)
@@ -1130,6 +1137,19 @@ class SessionSchemaMixin:
         # v32: nothing to run here. The declared tables/columns #106742 added under v31 were already
         # created by _init_schema's executescript(SCHEMA_SQL) + _reconcile_columns() before this chain;
         # the version only records that the store has them (#140315).
+        # v33: stamp the cutover to full-subject row stamping (hermes_state_mutation_binding.py). A row
+        # created before this timestamp may still carry the old, issuer-dropped `<provider>:<user>` form
+        # — the marker lets authorize_history's legacy fallback stay bounded to genuinely pre-existing
+        # rows forever, rather than guessing an equivalence for anything created afterward (which the
+        # CURRENT code never writes in the lossy form to begin with, so a post-cutover mismatch is a real
+        # foreign owner, not a legacy row). Written once, on first crossing — never overwritten, so a
+        # later migration run (or a replica catching up) does not move the boundary.
+        if current_version < 33:
+            from hermes_state_mutation_binding import _LEGACY_LABEL_CUTOVER_KEY
+            if cursor.execute(
+                "SELECT 1 FROM state_meta WHERE key=?", (_LEGACY_LABEL_CUTOVER_KEY,)
+            ).fetchone() is None:
+                cursor.execute(_STATE_META_UPSERT_SQL, (_LEGACY_LABEL_CUTOVER_KEY, str(time.time())))
         # Advance schema_version — deliberately NOT gated on the FTS opt-in (that would block
         # every future migration for a user who never optimizes). FTS5 unavailable is the
         # one skip: claiming current would lie.
diff --git a/tests/hermes_state/test_history_login_label.py b/tests/hermes_state/test_history_login_label.py
index 1378325c4d..3d012e6086 100644
--- a/tests/hermes_state/test_history_login_label.py
+++ b/tests/hermes_state/test_history_login_label.py
@@ -6,6 +6,17 @@ form (gateway/session_identity.py). ``authorize_history`` compared the two byte
 right logged-in user got ``permission_denied`` on rows it owned (#138950 review). The label maps
 only for an issuer-less login — the label drops the issuer, so an issuer-bearing subject must not
 claim one — and never to anything that itself reads as a subject.
+
+As of the full-subject stamping change, Desktop stamps NEW rows with the complete
+``auth:v1:[provider, issuer, user]`` subject directly (``authenticated_subject``) instead of the
+lossy ``<provider>:<user>`` label — every real OIDC login carries a non-empty issuer, and the old
+label dropped it unconditionally, so an issuer-bearing login could never satisfy an exact match
+against its own row. ``_login_label`` above is UNCHANGED and still correct for its original,
+narrower scope: an issuer-LESS login's row, stamped before this change or by an old client still
+running the prior format. Rows stamped under the old lossy form by an issuer-BEARING login are
+handled by a separate, bounded legacy fallback (``_legacy_transport_label`` /
+``_legacy_label_eligible``) that only ever resolves a row provably created before this host's
+recorded cutover to full-subject stamping — see the tests below this line.
 """
 
 import pytest
@@ -106,3 +117,89 @@ def test_a_forwarded_bob_cannot_mutate_a_row_bound_to_alice(db):
             authorize_history(conn, _actor(bob, db.db_path.parent), "alice-row", claim=True)
         assert getattr(raised.value, "reason", None) == "permission_denied"
         assert authorize_history(conn, _actor(alice, db.db_path.parent), "alice-row") is True
+
+
+# --- Legacy-cutover fallback: an issuer-bearing login reclaiming a pre-fix row -------------
+
+OIDC_LOGIN = 'auth:v1:["self-hosted","https://idp.example","userid:123"]'
+
+
+def _backdate(db, row_id, *, started_at):
+    db._conn.execute("UPDATE sessions SET started_at=? WHERE id=?", (started_at, row_id))
+    db._conn.commit()
+
+
+def _set_cutover(db, *, when):
+    from hermes_state_mutation_binding import _LEGACY_LABEL_CUTOVER_KEY
+    db._conn.execute(
+        "INSERT INTO state_meta(key,value) VALUES(?,?) "
+        "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
+        (_LEGACY_LABEL_CUTOVER_KEY, str(when)))
+    db._conn.commit()
+
+
+def test_a_fresh_store_already_has_a_cutover_marker(db):
+    """A brand-new store stamps the cutover at creation (alongside store_created_at_utc) so an
+    import of previously-exported legacy session data into it still has a boundary to compare
+    against — not just upgrading installs that pass through the version-gated migration chain."""
+    from hermes_state_mutation_binding import _LEGACY_LABEL_CUTOVER_KEY
+    with db._read_ctx() as conn:
+        row = conn.execute(
+            "SELECT value FROM state_meta WHERE key=?", (_LEGACY_LABEL_CUTOVER_KEY,)).fetchone()
+    assert row is not None
+    assert float(row[0]) > 0
+
+
+def test_an_issuer_bearing_login_reclaims_a_pre_cutover_row_and_upgrades_it(db):
+    """The actual bug this fallback fixes: a self-hosted OIDC login, which always carries an
+    issuer, can reclaim a row stamped under the old lossy form before this host's cutover — and
+    the row is upgraded in place so every later check hits the precise match directly."""
+    db.create_session("oidc-row", source="desktop", user_id="self-hosted:userid:123")
+    _backdate(db, "oidc-row", started_at=0.0)  # older than any real cutover timestamp
+    with db._read_ctx() as conn:
+        assert authorize_history(conn, _actor(OIDC_LOGIN, db.db_path.parent), "oidc-row", claim=True) is True
+    with db._read_ctx() as conn:
+        row = conn.execute("SELECT user_id FROM sessions WHERE id=?", ("oidc-row",)).fetchone()
+    assert row["user_id"] == OIDC_LOGIN
+    # Second touch now matches the FIRST branch (exact subject) directly — no fallback needed.
+    assert _auth(db, OIDC_LOGIN, "oidc-row") is True
+
+
+def test_a_pre_cutover_row_still_refuses_a_different_real_user(db):
+    """The legacy fallback never widens who may claim a row — same provider, a genuinely
+    different user, still refused even though the row predates the cutover."""
+    mallory = 'auth:v1:["self-hosted","https://idp.example","userid:999"]'
+    db.create_session("oidc-row", source="desktop", user_id="self-hosted:userid:123")
+    _backdate(db, "oidc-row", started_at=0.0)
+    with db._read_ctx() as conn:
+        with pytest.raises(Exception) as raised:
+            authorize_history(conn, _actor(mallory, db.db_path.parent), "oidc-row", claim=True)
+        assert getattr(raised.value, "reason", None) == "permission_denied"
+
+
+def test_a_post_cutover_row_never_gets_the_legacy_benefit(db):
+    """Bounding by creation time, not just format: a row stamped with the old lossy label but
+    created AFTER this host's cutover is never eligible for the fallback — current code never
+    writes that format, so a mismatch here is a real foreign owner, not a legacy row. Proves the
+    bound actually holds rather than merely never triggering by coincidence."""
+    _set_cutover(db, when=1000.0)
+    db.create_session("suspicious-row", source="desktop", user_id="self-hosted:userid:123")
+    _backdate(db, "suspicious-row", started_at=2000.0)  # after the (test-set) cutover
+    with db._read_ctx() as conn:
+        with pytest.raises(Exception) as raised:
+            authorize_history(conn, _actor(OIDC_LOGIN, db.db_path.parent), "suspicious-row", claim=True)
+        assert getattr(raised.value, "reason", None) == "permission_denied"
+
+
+def test_no_cutover_marker_means_the_fallback_refuses_rather_than_guesses(db):
+    """A store somehow missing the marker (should not happen via the two writers above, but
+    never assumed) fails closed: the fallback does not fire just because a row looks old."""
+    from hermes_state_mutation_binding import _LEGACY_LABEL_CUTOVER_KEY
+    db._conn.execute("DELETE FROM state_meta WHERE key=?", (_LEGACY_LABEL_CUTOVER_KEY,))
+    db._conn.commit()
+    db.create_session("oidc-row", source="desktop", user_id="self-hosted:userid:123")
+    _backdate(db, "oidc-row", started_at=0.0)
+    with db._read_ctx() as conn:
+        with pytest.raises(Exception) as raised:
+            authorize_history(conn, _actor(OIDC_LOGIN, db.db_path.parent), "oidc-row", claim=True)
+        assert getattr(raised.value, "reason", None) == "permission_denied"
